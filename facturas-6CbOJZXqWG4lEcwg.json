hedResultName":"Facturas","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1cnxoHb5DkaRxj5aO37fqFfZplRFjL5Pd3hoKK8R8c9c/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":"gid=0","mode":"list","cachedResultName":"Hoja 1","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1cnxoHb5DkaRxj5aO37fqFfZplRFjL5Pd3hoKK8R8c9c/edit#gid=0"},"options":{}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[1936,-144],"id":"0cf0bb9a-a1cf-4650-a9b6-63ef0f3b806a","name":"Get row(s) in sheet","credentials":{"googleSheetsOAuth2Api":{"id":"48LrMYRP5H1Lzwq0","name":"Google Sheets account 2"}}},{"parameters":{"jsCode":"// Obtener la fecha actual\nconst now = new Date();\nconst currentMonth = now.getMonth(); // 0 = enero\nconst currentYear = now.getFullYear();\n\n// Calcular mes anterior\nconst prevMonth = currentMonth === 0 ? 11 : currentMonth - 1;\nconst prevMonthYear = currentMonth === 0 ? currentYear - 1 : currentYear;\n\n// Filtrar items por mes actual o anterior\nconst filteredTotals = $input.all()\n  .map(item => {\n    const dateStr = item.json.Fecha_Factura; // formato \"dd/mm/yyyy\"\n    if (!dateStr) return null;\n\n    const [day, month, year] = dateStr.split(\"/\").map(Number);\n    const itemDate = new Date(year, month - 1, day);\n\n    // Comprobar si es este mes o el anterior\n    if ((itemDate.getFullYear() === currentYear && itemDate.getMonth() === currentMonth) ||\n        (itemDate.getFullYear() === prevMonthYear && itemDate.getMonth() === prevMonth)) {\n      return item.json.Total;\n    }\n    return null;\n  })\n  .filter(t => t !== null && t !== undefined);\n\n// Sumar los Totales filtrados\nconst totalSum = filteredTotals.reduce((acc, val) => acc + val, 0);\n\n// Devolver array y suma\nreturn [\n  {\n    json: {\n      totals: filteredTotals,\n      totalSum\n    }\n  }\n];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2128,-144],"id":"f792e840-9c01-4226-b12c-b6f8c95811e8","name":"Code in JavaScript"},{"parameters":{