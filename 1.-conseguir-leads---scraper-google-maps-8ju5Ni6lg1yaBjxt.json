n  ) {\n    const profileUrl = url.endsWith('/') ? url : url + '/';\n    matches.push(profileUrl);\n  }\n}\n\n// Elimina duplicados\nconst unique = [...new Set(matches)];\n\n// Usar el primer item de entrada, sin referenciar nodo externo\nconst item = $input.first().json;\n\nif (unique.length === 0) {\n  return [{ json: { instagram: null } }];\n}\n\nreturn unique.map(link => ({ json: { instagram: link } }));\n\n\n\n// return [\n//   {\n//     json: {\n//       instagram: $input.first().json.organic_results.find(r => r.link.includes(\"instagram.com\"))?.link || null\n//     }\n//   }\n// ];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1280,-800],"id":"bacd4924-d168-45dc-8ca6-16bc2e4cbbd4","name":"Code2","alwaysOutputData":false,"onError":"continueRegularOutput"},{"parameters":{"url":"=https://api.scraperapi.com?api_key=f92992af95633a6c3a5571128e8d2556&url=https://www.google.com/search?q=instagram+{{ $json.result.name }}+{{ $json.result.website }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"User-Agent","value":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/115.0"},{"name":"Accept","value":"text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,image/apng,*/*;q=0.8"},{"name":"Accept-Language","value":"es-ES,es;q=0.9,en;q=0.8"},{"name":"Accept-Encoding","value":"gzip, deflate, br"},{"name":"Connection","value":"keep-alive"},{"name":"Upgrade-Insecure-Requests","value":"1"},{"name":"Cache-Control","value":"max-age=0"},{"name":"Referer","value":"https://www.startpage.com/"},{"name":"DNT","value":"1"}]},"sendBody":true,"bodyParameters":{"parameters":[{}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1040,-800],"id":"7df65c2b-9067-4282-bb83-c4163a7dcc7e","name":"ScraperAPI1","onError":"continueRegularOutput"},{"parameters":{"content":"## No Borrar\n**Muy buenos solo que limitados a un numero al mes (Ej: 1000 peticiones al mes)**","color":3},"type":"n8n-no