st urlRegex = /https?:\\/\\/www.linkedin\\.com\\/in\\/[A-Za-z0-9\\-\\_]+/g;\nconst matches = combinedOutput.match(urlRegex);\n\n//3. Normalizar y eliminar duplicados\nif (matches && matches.length > 0) {\n  const uniqueUrlsObj = {};\n\n  matches.forEach(url => {\n    const normalizedUrl =url.replace(/^http:\\/\\//, \"https://\");\n    uniqueUrlsObj[normalizedUrl] = normalizedUrl;\n  });\n\n  const uniqueUrls = Object.values(uniqueUrlsObj);\n  \n//4. Devolver un solo item con todas las URLs únicas\n  return [\n    {\n      json: {\n        linkedinUrls: uniqueUrls\n      }\n    }\n  ];\n} else{\n  return [];\n}\n\n\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2640,464],"id":"98020cc8-884b-46e2-8b94-6bf286d4c9b0","name":"Code in JavaScript"},{"parameters":{"documentId":{"__rl":true,"value":"1y4_k08PY8YyYO4aj-yG6jIw9vqYiqPuhB5Ftn4xbw8c","mode":"list","cachedResultName":"Mensajes Linkedin Automatizados","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1y4_k08PY8YyYO4aj-yG6jIw9vqYiqPuhB5Ftn4xbw8c/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":"gid=0","mode":"list","cachedResultName":"Hoja 1","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1y4_k08PY8YyYO4aj-yG6jIw9vqYiqPuhB5Ftn4xbw8c/edit#gid=0"},"filtersUI":{"values":[{"lookupColumn":"contactado?","lookupValue":"no"}]},"options":{}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[2992,448],"id":"52b394eb-d093-412e-91b2-c28121ecd362","name":"Get row(s) in sheet","credentials":{"googleSheetsOAuth2Api":{"id":"48LrMYRP5H1Lzwq0","name":"Google Sheets account 2"}}},{"parameters":{},"type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[3200,448],"id":"99353415-d1d1-44c5-982b-fe192219b04d","name":"Merge"},{"parameters":{"jsCode":"//1. Recibir inputs y separar datos\nconst inputs = $input.all();\nlet linkedinUrls =[];\nconst sheetRows =[];\n\ninputs.forEach(item => {\n  if (item.json.linkedinUrls && Array.isArray(item.json.linkedinUrls)){\n    linkedinUrls = linked