 No digas cosas como \"apasionado por convertir visión en realidad\" o algo así. Sé extremadamente lacónico, simple austero, directo y sin adornos.\n\nSobre mi: apasionado del Marketing, de la IA y las automatizaciones ayudando a dueños de negocios a implementar esta tecnología dentro de sus procesos."},{"content":"{\"CamposLinkedin\": \"Lucía Fernández, Fort Lauderdale, Fundadora y CEO en Agencia X, experiencia previa: Directora regional de Ventas en Agencia X, Directora de Cuentas en Y}"},{"content":"{\n \"icebreaker\": \"Hola Lucía, me encantó ver tu camino con la agencia X. Yo también estoy en el mundo de las marcas y he pensado en conectar.\"\n}","role":"assistant"},{"content":"="}]},"jsonOutput":true,"options":{}},"type":"@n8n/n8n-nodes-langchain.openAi","typeVersion":1.8,"position":[832,48],"id":"9780b5da-49ef-42df-85a7-b80b650a7cfd","name":"Message a model","credentials":{"openAiApi":{"id":"CAtaEKjSBp0pcfHe","name":"OpenAi account"}}},{"parameters":{"operation":"append","documentId":{"__rl":true,"value":"1y4_k08PY8YyYO4aj-yG6jIw9vqYiqPuhB5Ftn4xbw8c","mode":"list","cachedResultName":"Mensajes Linkedin Automatizados","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1y4_k08PY8YyYO4aj-yG6jIw9vqYiqPuhB5Ftn4xbw8c/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":"gid=0","mode":"list","cachedResultName":"Hoja 1","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1y4_k08PY8YyYO4aj-yG6jIw9vqYiqPuhB5Ftn4xbw8c/edit#gid=0"},"columns":{"mappingMode":"defineBelow","value":{"contactado?":"No","icebreaker":"={{ $json.message.content.icebreaker }}"},"matchingColumns":["id"],"schema":[{"id":"id","displayName":"id","required":false,"defaultMatch":true,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"nombre","displayName":"nombre","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"apellido","displayName":"apellido","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"linkedin","displayName":"linkedin","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"titulo","displayName":"titulo","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"email","displayName":"email","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"icebreaker","displayName":"icebreaker","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"contactado?","displayName":"contactado?","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false}],"attemptToConvertTypes":false,"convertFieldsToString":false},"options":{}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[1248,48],"id":"a38704a4-f507-47dd-a4d5-bdea1314d6ec","name":"Append row in sheet","credentials":{"googleSheetsOAuth2Api":{"id":"48LrMYRP5H1Lzwq0","name":"Google Sheets account 2"}}},{"parameters":{"options":{}},"type":"n8n-nodes-base.splitInBatches","typeVersion":3,"position":[448,32],"id":"90be7bcd-e546-46e6-9106-71c2e60f3d19","name":"Loop Over Items"},{"parameters":{"fieldsToAggregate":{"fieldToAggregate":[{"fieldToAggregate":"id"}]},"options":{"mergeLists":true}},"type":"n8n-nodes-base.aggregate","typeVersion":1,"position":[848,-176],"id":"344a6421-f1b9-4286-953b-d6f17c1db5b7","name":"Aggregate"},{"parameters":{"content":"## Añadir esto cuando ya esten los leads esto:\n\nPrompt, Role User\n\n{\"Campos Linkedin\":\n   \"{{ $json.first_name }} {{ $json.last_name }}, {{ $json.city }}, {{ $json.title }} en {{ $json.organization.name }}, experiencia previa: {{ $json.employment_history[0].title }} en {{ $json.employment_history[0].organization_name }}, {{ $json.employment_history[1].title }} en {{ $json.employment_history[1].organization_name }}\n   \"\n}","height":320,"width":448,"color":6},"type":"n8n-nodes-base.stickyNote","position":[736,384],"typeVersion":1,"id":"2ba4c4da-077e-4782-88f1-e3ee370ad00d","name":"Sticky Note"},{"parameters":{"content":"## Leer nota de abajo\n","height":176,"width":288,"color":4},"type":"n8n-nodes-base.stickyNote","position":[800,0],"typeVersion":1,"id":"fad41307-573c-47fc-90bf-4dfb28036b4f","name":"Sticky Note1"},{"parameters":{"content":"## Enlaces:\n\nAPI: https://hub.phantombuster.com/reference/post_agents-launch\n\nPhantoms:\nhttps://phantombuster.com/2683033090834624/phantoms/8849052222036402/console\n\nhttps://hub.phantombuster.com/reference/get_agents-fetch-output\n\nAPI-KEY:\nhttps://phantombuster.com/2683033090834624/workspace-settings#api-keys\n","height":304,"width":416,"color":6},"type":"n8n-nodes-base.stickyNote","position":[1248,384],"typeVersion":1,"id":"87118e93-fb77-41a8-ae8a-79e36f4609ba","name":"Sticky Note2"},{"parameters":{"content":"## Lo que hace:\n\nSe encarga de generar el mensaje personalizado a ese lead de Linkedin a partir del contexto obtenido del Scrapper y guardarlo en el sheets para que luego Phantom pueda coger ese mensaje y ponerlo allí","height":240,"width":272,"color":5},"type":"n8n-nodes-base.stickyNote","position":[1472,0],"typeVersion":1,"id":"fb42f861-2b9f-4861-8109-c494793d94ee","name":"Sticky Note3"},{"parameters":{"url":"https://api.phantombuster.com/api/v2/agents/fetch-output","sendQuery":true,"queryParameters":{"parameters":[{"name":"id","value":"={{ $json.containerId }}"},{"name":"mode","value":"json"}]},"sendHeaders":true,"headerParameters":{"parameters":[{"name":"X-Phantombuster-Key","value":"bKezuy3OjnKoOsga63iJ4enANqug77ybnL6ZJtqytVw"},{"name":"accept","value":"application/json"}]},"options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1536,-176],"id":"8a429000-697b-47a3-b3a7-814dda30feb8","name":"HTTP Request1"},{"parameters":{"jsCode":"// 1. Combinar todos los outputs en uno solo\nconst combinedOutput = items.map(item => item.json.output).join('\\n');\n\n// 2. Buscar todas las URLs de LinkedIn en el texto combinado\nconst urlRegex = /https?:\\/\\/www.linkedin\\.com\\/in\\/[A-Za-z0-9\\-\\_]+/g;\nconst matches = combinedOutput.match(urlRegex);\n\n//3. Normalizar y eliminar duplicados\nif (matches && matches.length > 0) {\n  const uniqueUrlsObj = {};\n\n  matches.forEach(url => {\n    const normalizedUrl =url.replace(/^http:\\/\\//, \"https://\");\n    uniqueUrlsObj[normalizedUrl] = normalizedUrl;\n  });\n\n  const uniqueUrls = Object.values(uniqueUrlsObj);\n  \n//4. Devolver un solo item con todas las URLs únicas\n  return [\n    {\n      json: {\n        linkedinUrls: uniqueUrls\n      }\n    }\n  ];\n} else{\n  return [];\n}\n\n\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[1792,-176],"id":"98020cc8-884b-46e2-8b94-6bf286d4c9b0","name":"Code in JavaScript"},{"parameters":{"documentId":{"__rl":true,"value":"1y4_k08PY8YyYO4aj-yG6jIw9vqYiqPuhB5Ftn4xbw8c","mode":"list","cachedResultName":"Mensajes Linkedin Automatizados","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1y4_k08PY8YyYO4aj-yG6jIw9vqYiqPuhB5Ftn4xbw8c/edit?usp=drivesdk"},"sheetName":{"__rl":true,"value":"gid=0","mode":"list","cachedResultName":"Hoja 1","cachedResultUrl":"https://docs.google.com/spreadsheets/d/1y4_k08PY8YyYO4aj-yG6jIw9vqYiqPuhB5Ftn4xbw8c/edit#gid=0"},"filtersUI":{"values":[{"lookupColumn":"contactado?","lookupValue":"no"}]},"options":{}},"type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[2032,-272],"id":"52b394eb-d093-412e-91b2-c28121ecd362","name":"Get row(s) in sheet","credentials":{"googleSheetsOAuth2Api":{"id":"48LrMYRP5H1Lzwq0","name":"Google Sheets account 2"}}},{"parameters":{},"type":"n8n-nodes-base.merge","typeVersion":3.2,"position":[2224,-64],"id":"99353415-d1d1-44c5-982b-fe192219b04d","name":"Merge"},{"parameters":{"jsCode":"//1. Recibir inputs y separar datos\nconst inputs = $input.all();\nlet linkedinUrls =[];\nconst sheetRows =[];\n\ninputs.forEach(item => {\n  if (item.json.linkedinUrls && Array.isArray(item.json.linkedinUrls)){\n    linkedinUrls = linkedinUrls.concat(item.json.linkedinUrls);\n  }\n\n  if(item.json.row_number && item.json.linkedin_url){\n    sheetRows.push(item.json);\n  }\n});\n\n// 2.Normalizar las URLs (convertir de http a https y eliminar www)\nlinkedinUrls = linkedinUrls.map(url => {\n  url.trim().replace(/^http:/, 'https:').replace(/^https:\\/\\/www\\./, 'https://')\n})"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[2432,-64],"id":"95581cde-f455-4d83-bf64-a2e73f315f35","name":"Code in JavaScript1"},{"parameters":{"method":"POST","url":"https://sheets.googleapis.com/v4/spreedsheets/1y4_k08PY8YyYO4aj-yG6jIw9vqYiqPuhB5Ftn4xbw8c/values:batchUpdate","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"Bearer <Crear la clave API>"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{ $json.batchUpdatePayloadText }}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[2640,-64],"id":"7fc08450-f38e-4055-a862-eff88867335e","name":"HTTP Request2"},{"parameters":{"content":"## Añadir autenticación","height":272,"color":3},"type":"n8n-nodes-base.stickyNote","position":[2368,-144],"typeVersion":1,"id":"517ea1f7-c8e1-4d36-b831-d3b460c6569d","name":"Sticky Note4"},{"parameters":{"unit":"minutes"},"type":"n8n-nodes-base.wait","typeVersion":1.1,"position":[1328,-176],"id":"4af1c481-742b-4c1f-9b8a-2e2aa69eb15b","name":"Wait","webhookId":"20f6b591-f21e-4bd1-9d75-ff20a07ceeca"}],"connections":{"When clicking ‘Execute workflow’":{"main":[[{"node":"Loop Over Items","type":"main","index":0}]]},"Message a model":{"main":[[{"node":"Append row in sheet","type":"main","index":0}]]},"Loop Over Items":{"main":[[{"node":"Aggregate","type":"main","index":0}],[{"node":"Message a model","type":"main","index":0}]]},"Aggregate":{"main":[[{"node":"HTTP Request","type":"main","index":0}]]},"HTTP Request":{"main