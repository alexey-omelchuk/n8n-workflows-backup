[{"createdAt":"2025-07-18T16:53:59.758Z","updatedAt":"2025-07-24T11:06:08.190Z","id":"LbdVjOq5eoCkDNIy","name":"Publicacion Linkedin","active":false,"isArchived":false,"nodes":[{"parameters":{"content":"### Latest company news before a call\n\nThis workflow will send you a list of latest news about a company for every meeting in your calendar each day, keeping you up to date with your leads and meeting partners.\n","height":192,"width":436,"color":4},"id":"9bb5adfa-5a36-453e-ad8d-59229ca2f1ab","name":"Sticky Note","type":"n8n-nodes-base.stickyNote","position":[2820,260],"typeVersion":1},{"parameters":{"content":"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n### Configure your workflow here\n1. `apiKey` - Your API key for [News API](https://newsapi.org)\n2. `newsAge` - How old should news be, in days\n3. `maxArticles` - Number of articles that will be sent, max 100\n4. `emails`- List of email addresses that should receive the news, separated by commas","height":511.499984507795},"id":"182504b0-3cf6-4afe-ba93-1d2bf7a02fa3","name":"Sticky Note1","type":"n8n-nodes-base.stickyNote","position":[2960,660],"typeVersion":1},{"parameters":{"content":"\n\n\n\n\n\n\n\n\n\n\n\n\nThis will get all meetings that start with *Meeting with* or *Call with* but feel free to update the filter to suit your needs.","height":275.2500697149263,"width":231.52514020446353},"id":"604bc73b-f805-40df-baa0-eb3de4c515f3","name":"Sticky Note2","type":"n8n-nodes-base.stickyNote","position":[2960,480],"typeVersion":1},{"parameters":{"rule":{"interval":[{"triggerAtHour":7}]}},"id":"ddfa92e0-ff37-4733-9002-65fe21989d8a","name":"Todas las mañanas","type":"n8n-nodes-base.scheduleTrigger","position":[380,600],"typeVersion":1.1},{"parameters":{"fields":{"values":[{"name":"apiKey","stringValue":"32aa914c947342169c4998b6701a77e0"},{"name":"newsAge","type":"numberValue","numberValue":"10"},{"name":"maxArticles","stringValue":"20"},{"name":"emails"}]},"options":{}},"id":"9aa9fa6c-5ccb-4f2b-b6a8-2b91f4a58355","name":"Parametros","type":"n8n-nodes-base.set","position":[600,600],"typeVersion":3.2},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"bcfb06b1-d365-43a8-9802-869529baca98","operator":{"type":"string","operation":"startsWith"},"leftValue":"={{ $json.summary.toLowerCase() }}","rightValue":"call with"},{"id":"4ea43ccf-d586-4985-87db-fc1e9f734351","operator":{"type":"string","operation":"startsWith"},"leftValue":"={{ $json.summary.toLowerCase() }}","rightValue":"meeting with"}],"combinator":"or"},"options":{}},"id":"b71c3683-6077-41b4-ab23-66ee22f64532","name":"Filtrar reuniones","type":"n8n-nodes-base.if","position":[1020,600],"typeVersion":2},{"parameters":{},"id":"318b2bdc-712f-42a8-b224-8f0dc2c9c4e5","name":"No hay reuniones","type":"n8n-nodes-base.noOp","position":[1880,620],"typeVersion":1},{"parameters":{"fields":{"values":[{"name":"companyName","stringValue":"={{ $json.summary.toLowerCase().replace('meeting with', '').replace('call with', '').trim() }}"}]},"options":{}},"id":"6f471217-b69b-4f67-981d-c7c1e2d710b6","name":"Obtener Nombre Compañia","type":"n8n-nodes-base.set","position":[1280,400],"typeVersion":3.2},{"parameters":{"url":"=https://newsapi.org/v2/everything?apiKey={{ $('Parametros').first().json.apiKey }}&q={{ $json.companyName }}&from={{ DateTime.now().minus({ days: $('Parametros').first().json.newsAge }).toFormat('yyyy-MM-dd') }}&sortBy=publishedAt&language=en&pageSize={{ $('Parametros').first().json.maxArticles }}&searchIn=title","options":{}},"id":"34c4241e-e29a-4d9a-b8a8-130b9f19383f","name":"Obtener últimas noticias","type":"n8n-nodes-base.httpRequest","position":[1480,400],"typeVersion":4.1},{"parameters":{"mode":"runOnceForEachItem","jsCode":"let html = `<table style=\"width: 100%\">`;\nhtml += '</table>';\n\nfor(article of $input.item.json.articles) {\n  console.log(article)\n  html += `\n    <tr>\n      <td style=\"display: flex; background-color: #f2f4f8; font-family: sans-serif; padding: 0.3em 0.5em\">\n        <div style=\"padding: 1em\">\n          <a style=\"display: block; margin-bottom: 10px; font-size: 1.2em\" href=\"${article.url}\">${article.title}</a>\n          <i>\n            ${article.description ? article.description : article.content}\n          </i>\n          <div style=\"margin-top: 1em\">\n            ${ article.source?.name ? '<b>Source:</b> ' + article.source?.name : '' }\n          </div>\n        </div>\n      </td>\n    </tr>\n  `\n}\nreturn { \"html\": html };"},"id":"51059db7-5fec-4287-bf3f-a6a4e76ac5a4","name":"Crear mensaje","type":"n8n-nodes-base.code","position":[1680,400],"typeVersion":2},{"parameters":{"sendTo":"={{ $('Parametros').first().json.emails }}","subject":"=Latest news for '{{ $('Obtener Nombre Compañia').item.json.summary }}'","message":"={{ $json.html }}","options":{}},"id":"9b4351a8-edf9-49ef-829e-6998cb1eea2c","name":"Enviar noticia","type":"n8n-nodes-base.gmail","position":[1880,400],"typeVersion":2.1,"webhookId":"6d0a8352-5b07-4cbf-95b1-c8de86ba3fc9","credentials":{"gmailOAuth2":{"id":"0NQwFo3lhfGFZXTV","name":"Gmail account"}}}],"connections":{"Todas las mañanas":{"main":[[{"node":"Parametros","type":"main","index":0}]]},"Parametros":{"main":[[{"node":"Filtrar reuniones","type":"main","index":0}]]},"Filtrar reuniones":{"main":[[{"node":"Obtener Nombre Compañia","type":"main","index":0}],[{"node":"No hay reuniones","type":"main","index":0}]]},"Obtener Nombre Compañia":{"main":[[{"node":"Obtener últimas noticias","type":"main","index":0}]]},"Obtener últimas noticias":{"main":[[{"node":"Crear mensaje","type":"main","index":0}]]},"Crear mensaje":{"main":[[{"node":"Enviar noticia","type":"main","index":0}]]}},"settings":{},"staticData":null,"meta":{"templateId":"2110","templateCredsSetupCompleted":true},"pinData":{},"versionId":"f627186e-6df7-4c08-84f9-c1032660d230","triggerCount":0,"shared":[{"createdAt":"2025-07-18T16:53:59.758Z","updatedAt":"2025-07-18T16:53:59.758Z","role":"workfl