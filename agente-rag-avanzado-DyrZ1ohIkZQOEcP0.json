ng VECTOR(1536)  -- Para embeddings de OpenAI (1536 dimensiones)\n);\n\n-- 3️⃣ Crear función de búsqueda por similitud\nCREATE OR REPLACE FUNCTION match_documents(\n    query_embedding VECTOR(1536),\n    match_count INT DEFAULT NULL,\n    filter JSONB DEFAULT '{}'\n)\nRETURNS TABLE (\n    id BIGINT,\n    content TEXT,\n    metadata JSONB,\n    similarity FLOAT\n)\nLANGUAGE plpgsql\nAS $$\n#variable_conflict use_column\nBEGIN\n    RETURN QUERY\n    SELECT\n        id,\n        content,\n        metadata,\n        1 - (documents.embedding <=> query_embedding) AS similarity  -- Similaridad coseno\n    FROM documents\n    WHERE metadata @> filter\n    ORDER BY documents.embedding <=> query_embedding  -- Ordena por distancia\n    LIMIT match_count;\nEND;\n$$;\n","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[-432,1648],"id":"0747e03c-b5c7-4cca-9032-9e0d81cce5c1","name":"Crear tabla de documentos y función para Match","credentials":{"postgres":{"id":"nD70oPfLuaHAGsaN","name":"Postgres account"}}},{"parameters":{"operation":"executeQuery","query":"-- 1️⃣ Crear tabla\nCREATE TABLE memories (\n    id BIGSERIAL PRIMARY KEY,\n    content TEXT,                       -- Corresponde a Document.pageContent\n    metadata JSONB,                      -- Corresponde a Document.metadata\n    embedding VECTOR(1536)               -- Para embeddings de OpenAI (1536 dimensiones)\n);\n\n-- 2️⃣ Crear función para buscar por similitud\nCREATE OR REPLACE FUNCTION match_documents(\n    query_embedding VECTOR(1536),\n    match_count INT DEFAULT NULL,\n    filter JSONB DEFAULT '{}'\n)\nRETURNS TABLE (\n    id BIGINT,\n    content TEXT,\n    metadata JSONB,\n    similarity FLOAT\n)\nLANGUAGE plpgsql\nAS $$\n#variable_conflict use_column\nBEGIN\n    RETURN QUERY\n    SELECT\n        id,\n        content,\n        metadata,\n        1 - (memories.embedding <=> query_embedding) AS similarity   -- Similaridad coseno\n    FROM memories\n    WHERE metadata @> filter\n    OR