ambia si querés otro límite\nconst TIMESTAMP_FIELD = 'updatedAt';   // Nombre del campo con la fecha del último mensaje\n\n// 🕓 Lógica principal\nconst now = new Date();\nconst inactiveLeads = [];\n\nfor (const item of $input.all()) {\n  const data = item.json;\n\n  // Convierte la fecha ISO (ej. 2025-10-13T10:00:37.348Z)\n  const lastUpdate = new Date(data[TIMESTAMP_FIELD]);\n\n  if (isNaN(lastUpdate)) {\n    console.warn(`⚠️ Fecha inválida para ${data.identificador || 'sin ID'}`);\n    continue;\n  }\n\n  // Calcula diferencia en minutos\n  const diffMinutes = (now - lastUpdate) / 60000;\n\n  // Si superó el límite → lo consideramos inactivo\n  if (diffMinutes >= INACTIVITY_LIMIT_MINUTES) {\n    inactiveLeads.push(item);\n  }\n}\n\n// 🔁 Devuelve solo las conversaciones inactivas\nreturn inactiveLeads;\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[912,352],"id":"d6c03f18-4b23-4434-aaff-f862d8002a0f","name":"Code in JavaScript2"},{"parameters":{"operation":"update","dataTableId":{"__rl":true,"value":"TG5UnjO4B9GEkuKt","mode":"list","cachedResultName":"Leads","cachedResultUrl":"/projects/vgYEkg41PSq0E4wM/datatables/TG5UnjO4B9GEkuKt"},"filters":{"conditions":[{"keyName":"identificador","keyValue":"={{ $json.identificador }}"}]},"columns":{"mappingMode":"defineBelow","value":{"conversacion_abierta":false},"matchingColumns":[],"schema":[{"id":"Nombre","displayName":"Nombre","required":false,"defaultMatch":false,"display":true,"type":"string","readOnly":false,"removed":true},{"id":"Mensaje","displayName":"Mensaje","required":false,"defaultMatch":false,"display":true,"type":"string","readOnly":false,"removed":true},{"id":"identificador","displayName":"identificador","required":false,"defaultMatch":false,"display":true,"type":"number","readOnly":false,"removed":true},{"id":"conversacion_abierta","displayName":"conversacion_abierta","required":false,"defaultMatch":false,"display":true,"type":"boolean","readOnly":false,"removed":false}],"attemptToConvertTypes"